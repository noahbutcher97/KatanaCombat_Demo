{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              ".claude/hooks/session-start.ps1"
            ]
          }
        ]
      }
    ],
    "beforeToolCall": {
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        ".claude/hooks/agent-reminder.ps1"
      ]
    },
    "afterFileOpen": {
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        ".claude/hooks/auto-context.ps1"
      ]
    },
    "afterEdit": {
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        ".claude/hooks/after-edit.ps1"
      ]
    }
  }
}